# Paste into Dokploy's Environment tab and replace the two required values.
# These are placeholders. Do not commit real credentials.
APP_ORIGIN=https://dots.your-domain.com
OWNER_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_24_CHARACTERS
OWNER_ID=opendots-owner

# AI chat: select a CopilotKit Intelligence project, then add its project key.
# Keep the CLI-generated telemetry ID with its corresponding project key.
CPK_INTELLIGENCE_API_KEY=
CPK_TELEMETRY_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional voice calls: a Realtime-capable key and model are required.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Public-web research defaults to Parallel; no key needed for light use.
WEB_SEARCH_PROVIDER=parallel
PARALLEL_API_KEY=

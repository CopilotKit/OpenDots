# Template for a self-hosted + LAN/Tailscale OpenDots .env.
# Copy to .env and fill in. NEVER commit real secrets.
#
# `npx copilotkit@latest local connect --approve-connection` writes the
# Intelligence block (INTELLIGENCE_API_URL / INTELLIGENCE_GATEWAY_WS_URL /
# CPK_INTELLIGENCE_API_KEY) for you.

HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
OWNER_ID=opendots-owner

# Exact browser origins you access the app from. Hostnames are also whitelisted
# for API requests, so list every host (LAN IP, tailnet IP, hostname).
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://<LAN-IP>:5173,http://<TAILSCALE-IP>:5173

# --- Local Intelligence (written by `copilotkit local connect`) ---
INTELLIGENCE_API_URL=http://localhost:<api-port>
# Must be reachable BY THE BROWSER. Because the stack publishes on loopback,
# forward the port (see opendots-gateway-*.service) and use the host you access with.
INTELLIGENCE_GATEWAY_WS_URL=ws://<browser-reachable-host>:<gateway-port>
CPK_INTELLIGENCE_API_KEY=cpk-...

# --- Model (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# --- Public web research (optional) ---
WEB_SEARCH_PROVIDER=parallel

# --- Slack (local stack: create the managed channel in the dashboard first) ---
# SLACK_CHANNEL_NAME is the MANAGED channel name, not a #channel.
SLACK_CHANNEL_NAME=
SLACK_TEAM_ID=
SLACK_USER_IDS=

# --- Voice (OpenAI Realtime API) ---
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin
